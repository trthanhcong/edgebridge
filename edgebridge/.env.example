# ============================================================
# EdgeBridge Gateway - Environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit your real .env file.
# ============================================================

# --- Network ---
# Port the proxy listens on (handles both SOCKS5 and HTTP CONNECT).
PORT=1080

# Bind address. Use 0.0.0.0 to accept remote connections (needed when exposed),
# or 127.0.0.1 to only accept local connections.
BIND_HOST=0.0.0.0

# Port for the health-check HTTP endpoint (separate from the proxy port).
HEALTH_PORT=8080

# --- Authentication ---
# Auth mode. One of: "userpass" or "token".
AUTH_MODE=userpass

# For AUTH_MODE=userpass:
#   Provide credentials as: user1:pass1,user2:pass2
#   (comma-separated pairs). Do NOT use quotes.
AUTH_USERS=changeme_user:changeme_password

# For AUTH_MODE=token:
#   A single shared bearer token. Presented by the client as
#   username="token", password="<AUTH_TOKEN>".
AUTH_TOKEN=changeme_token_use_a_long_random_string

# --- Access control ---
# Comma-separated allowlist of destination host patterns the proxy may reach.
# Supports exact hosts and wildcard suffixes, e.g.:
#   *              -> allow everything (NOT recommended)
#   *.example.com  -> allow any subdomain of example.com
#   api.github.com -> allow exactly this host
# Leave as * only in trusted/dev environments.
ALLOWLIST=*

# Optional: comma-separated list of destination ports allowed.
# Empty means all ports allowed. Example: 80,443
ALLOWED_PORTS=

# --- Logging ---
# Log level: error | warn | info | debug
LOG_LEVEL=info
